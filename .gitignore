# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.ipynb_checkpoints/
.venv/
venv/
env/

# --- NEURON compiled mechanisms (build artifacts; keep only the .mod source) ---
x86_64/
arm64/
aarch64/
i686/
umac/
nrnmech.dll
*.dll
neuron_simulation/mechanisms/*.c
neuron_simulation/mechanisms/*.o
neuron_simulation/mechanisms/mod_func.*
neuron_simulation/mechanisms/.tmp*

# --- Simulation output / data folders ---
# New raw-data sessions are ignored by default; committing a dataset is a
# deliberate act (git add -f). The pilot sessions under notebooks/"NEURON data"
# and the named sessions under notebooks/"NEURON data parallel" were committed
# that way and stay tracked (ignore rules never affect already-tracked files).
NEURON data/
NEURON_data/
data/
sessions/

# --- Inference output directories ---
learned_lif_outputs/
voltage_augmented_learned_lif_outputs/
ccg_outputs/
correlation_outputs/
inference_outputs/

# --- Run logs (console captures; the historical ones live in archive/logs/) ---
*.log
*.err
!archive/logs/*.log

# --- CHTC sweep sessions (raw data assembled by chtc/collect.py; ~GBs each,
#     committing one is a deliberate git add -f) ---
notebooks/NEURON data parallel/sweep_*/

# --- CHTC kit byproducts on the access point (submit-side artifacts and
#     job-returned output tars) ---
chtc/jobs.txt
chtc/repo.tar.gz
chtc/logs/
chtc/*.sif
chtc/*_r*.tar

# --- Voltage sidecars & large artifacts ---
*.h5
*.hdf5

# --- Generated plots ---
*.png
*.pdf
*.svg
!docs/**/*.png
# committed analysis figures live under <session>/results/<state>/figures/ and are
# indexed by results/FIGURES.md -- keep them out of the blanket *.png rule
!**/results/**/figures/*.png
# cross-state comparison figures sit at the session results/ root (e.g.
# compare_states_glm.png)
!**/results/*.png
# the curated root figures/ set (referenced by analysis/README.md) and the
# archived historical renders
!figures/*.png
!archive/figures/*.png

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# retired learned-LIF training checkpoints kept locally, out of version control
archive/lif_checkpoints/
