# --- Simulation output / data folders ---
NEURON data/
NEURON_data/
data/
sessions/

# --- Inference output directories ---
learned_lif_outputs/
voltage_augmented_learned_lif_outputs/
ccg_outputs/
correlation_outputs/
inference_outputs/

# --- Voltage sidecars & large artifacts ---
*.h5
*.hdf5

# --- Generated plots ---
*.png
*.pdf
*.svg
!docs/**/*.png
# committed analysis figures live under <session>/results/<state>/figures/ and are
# indexed by results/FIGURES.md -- keep them out of the blanket *.png rule
!**/results/**/figures/*.png

