# HTCondor submit file for the baseline-methods sweep (chtc/baselines_one.py).
# One job = one (session, state, method): both arms (full, burst-excluded),
# n=200 recordings, spike-only inputs.  CPU-only, no NEURON.
#
#   python3 chtc/make_baselines_manifest.py   # LOCALLY: jobs + tarballs
#   scp the kit up, then on the access point:
#   SWEEP=baselines bash chtc/submit_all.sh YOUR_NETID

container_image = file:///staging/YOUR_NETID/neuron-sim.sif
universe = container

executable = baselines_job.sh
arguments = $(session) $(state) $(method) 200

transfer_input_files = repo_baselines.tar.gz, spikes/spikes_$(session)_$(state).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = baselines_$(session)_$(state)_$(method).tar

log    = logs/baselines_$(Cluster).log
output = logs/baselines_$(session)_$(state)_$(method).out
error  = logs/baselines_$(session)_$(state)_$(method).err

# glmcc is the heavy one (per-pair Newton fits); everything else finishes in
# minutes.  Memory: the 1 ms lag-product stack + ridge Gram + surrogates.
request_cpus   = 4
request_memory = 12GB
request_disk   = 4GB

max_retries = 3
requirements = (Target.HasCHTCStaging == true)

queue session,state,method from baselines_jobs.txt
